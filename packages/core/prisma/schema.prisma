datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Scan {
  id           String       @id @default(cuid())
  repoUrl      String
  repoOwner    String
  repoName     String
  status       String       @default("pending") // pending | scanning | complete | failed
  totalDeps    Int          @default(0)
  totalVulns   Int          @default(0)
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())
  completedAt  DateTime?
  dependencies Dependency[]
}

model Dependency {
  id              String          @id @default(cuid())
  scanId          String
  scan            Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ecosystem       String          // npm | maven | pypi
  name            String
  version         String
  manifestPath    String          // which file it came from
  isDev           Boolean         @default(false)
  vulnerabilities Vulnerability[]

  @@index([scanId])
  @@index([ecosystem, name, version])
}

model Vulnerability {
  id                 String     @id @default(cuid())
  dependencyId       String
  dependency         Dependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  cveId              String?
  severity           String     // CRITICAL | HIGH | MEDIUM | LOW | UNKNOWN
  cvssScore          Float?
  cvssVector         String?
  summary            String     @db.Text
  details            String?    @db.Text
  publishedDate      String?
  modifiedDate       String?
  fixedVersions      String?    @db.Text  // JSON array stored as string
  references         String?    @db.Text  // JSON array stored as string
  source             String     // OSV | NVD
  affectedRange      String?

  @@index([dependencyId])
  @@index([cveId])
  @@index([severity])
}
