# GitHub Personal Access Token (https://github.com/settings/tokens)
# Needs 'repo' scope for reading repository contents
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NIST NVD API Key (https://nvd.nist.gov/developers/request-an-api-key)
# Optional but recommended — increases rate limit from 5 to 50 requests per 30 seconds
NVD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Gemini API Key (https://aistudio.google.com/apikey)
# Used in Phase 2 for embeddings and LLM reasoning
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PostgreSQL Database URL (matches docker-compose.yml)
DATABASE_URL=postgresql://vulnshield:vulnshield_dev@localhost:5432/vulnshield
